# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Primary LLM provider: Groq (free, no card needed — console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Backup LLM provider: OpenRouter (free tier — openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Which Groq model to use for text extraction / explanation
# Verify current availability at console.groq.com/docs/models
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Which Groq model to use for vision (OCR fallback)
# Verify current availability at console.groq.com/docs/models
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: Tesseract binary path (Windows only, usually auto-detected)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
